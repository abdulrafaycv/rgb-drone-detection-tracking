# ============================================================
# RGB Drone Detection, Tracking & Deployment
# .gitignore
# ============================================================


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*.pyo

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Python test / coverage files
.pytest_cache/
.coverage
.coverage.*
htmlcov/


# ============================================================
# Environment Variables / Secrets
# ============================================================

.env
.env.*
!.env.example

# Local configuration files that may contain credentials
secrets/
credentials/
*.secret


# ============================================================
# Jupyter Notebook
# ============================================================

.ipynb_checkpoints/


# ============================================================
# IDE / Editors
# ============================================================

.vscode/
.idea/

# Vim
*.swp
*.swo

# VS Code local history
.history/


# ============================================================
# Operating System
# ============================================================

.DS_Store
Thumbs.db
desktop.ini


# ============================================================
# Logs
# ============================================================

*.log
*.logs


# ============================================================
# Temporary / Cache Files
# ============================================================

*.tmp
*.temp
*.cache

tmp/
temp/
.cache/


# ============================================================
# Ultralytics / YOLO Generated Files
# ============================================================

# Default Ultralytics training output
runs/

# Weights & Biases
wandb/

# Ultralytics dataset cache files
*.cache


# ============================================================
# LOCAL / PRIVATE DATASETS
# ============================================================

# Original base dataset
datasets/base/

# Original fine-tuning dataset
datasets/finetuned/

# Raw / unprocessed datasets
datasets/raw/

# Any local dataset images
datasets/*/images/

# Any local dataset labels
datasets/*/labels/

# Dataset archives
datasets/**/*.zip
datasets/**/*.rar
datasets/**/*.7z
datasets/**/*.tar
datasets/**/*.tar.gz


# ============================================================
# LOCAL EXPERIMENTS
# ============================================================

experiments/
experiment/
local_runs/

# TensorBoard logs
tensorboard/
logs/


# ============================================================
# C++ Build Artifacts
# ============================================================

# Generic C/C++ build directories
build/
cmake-build-*/
out/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# Make files generated by CMake
Makefile

# Object files
*.o
*.obj

# Static libraries
*.a
*.lib

# Shared libraries
*.so
*.dll
*.dylib

# Debug symbols
*.dSYM/


# ============================================================
# Executables
# ============================================================

# NOTE:
# main1_cpp is intentionally NOT ignored because it is currently
# part of the deployment folder and may be included in the repo.
#
# If you later decide to exclude compiled executables, uncomment:
#
# deployment_cpp/main1_cpp


# ============================================================
# Generated ONNX / TensorRT Files
# ============================================================

# IMPORTANT:
# These are intentionally NOT ignored.
#
# The repository contains deployment artifacts such as:
#
# *.onnx
# *.engine
#
# because they demonstrate the actual deployment pipeline.
#
# Do NOT add *.onnx or *.engine here unless you decide to
# remove those deployment artifacts from the repository.


# ============================================================
# Model Weights
# ============================================================

# IMPORTANT:
# Model weights are intentionally NOT ignored.
#
# The repository contains:
#
# best.pt
# last.pt
# rgb_finetuned.pt
#
# because they are part of the project and allow users to run
# the trained models without access to the original datasets.
#
# Do NOT add:
#
# *.pt
# *.pth
#
# unless you later decide to remove model weights from GitHub.


# ============================================================
# Local Media / Testing Files
# ============================================================

# Local test videos
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Local test images
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff

# ------------------------------------------------------------
# IMPORTANT:
# If you want to upload selected screenshots/results to GitHub,
# DO NOT use a global *.png ignore rule.
#
# Therefore, images are NOT globally ignored above.
# Add individual local media directories instead if necessary.
# ------------------------------------------------------------

# Example:
# test_media/
# demo/raw/
# local_images/


# ============================================================
# Generated Documentation
# ============================================================

docs/_build/
site/


# ============================================================
# OS / Backup Files
# ============================================================

*.bak
*.backup
*~
